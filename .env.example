# Postgres. Local docker is on 5433 (Windows Postgres owns 5432).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/appdb
# Cloud Run (deploy env only): postgresql+psycopg://USER:ENCODED_PW@/appdb?host=/cloudsql/PROJECT:REGION:INSTANCE
POSTGRES_DB=appdb
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# bm25 (pg_textsearch) | tsvector (plain Postgres fallback)
KEYWORD_ENGINE=bm25

FIREBASE_PROJECT_ID=demo-local-app
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# S3 API: MinIO locally, GCS HMAC keys on Cloud Run
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# Never true in production
RUN_LOCAL_WORKERS=true
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=900

# local | cloudrun | none
QUEUE_DISPATCHER=local
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=
CLOUD_RUN_JOB_NAME=
