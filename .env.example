# ============================================================================
# Knowledge Cartographer — Complete .env.example
# Copy to .env and fill in the required values.
# ============================================================================

# --- 1. Postgres (Source of Truth + pgvector + pg_textsearch) ---
# Local Docker is mapped to port 5433 (Windows Postgres typically owns 5432).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/appdb
# Cloud Run (deploy env only):
# DATABASE_URL=postgresql+psycopg://USER:ENCODED_PW@/appdb?host=/cloudsql/PROJECT:REGION:INSTANCE
POSTGRES_DB=appdb
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Keyword search engine: bm25 (pg_textsearch) | tsvector (plain Postgres fallback)
KEYWORD_ENGINE=bm25

# --- 2. Neo4j AuraDB (Graph Projection & Traversal Engine) ---
# Obtain from Neo4j Aura Console (e.g. neo4j+s://<instance-id>.databases.neo4j.io)
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- 3. Gemini / Vertex AI (Embeddings, Image/Diagram Indexing, Chat) ---
# google-genai reads these directly. Pick ONE authentication mode:
#   Option A — AI Studio API Key:
GEMINI_API_KEY=
#   Option B — Vertex AI via Application Default Credentials (ADC):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

IMAGE_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=BAAI/bge-base-en-v1.5
CHAT_MODEL=gemini-3.1-flash-lite

# Optional OpenRouter reasoning model override (used automatically for chat & deep research when set):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- 4. Firebase Authentication ---
FIREBASE_PROJECT_ID=demo-local-app
# Set in local dev only when using the Firebase Auth Emulator; leave blank in production:
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- 5. Object Storage (S3-compatible: MinIO locally, GCS HMAC keys in prod) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kc-uploads
S3_REGION=us-east-1

# --- 6. Background Worker & Job Dispatcher ---
# RUN_LOCAL_WORKERS=true starts in-process workers inside FastAPI lifespan (local dev only; MUST be false in prod)
RUN_LOCAL_WORKERS=true
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=900

# Dispatcher mode: local | cloudrun | none
QUEUE_DISPATCHER=local
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=
CLOUD_RUN_JOB_NAME=

# --- 7. Web / CORS & Request-Scoped Search ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
# SerpApi keys are user-provided on their own device (Settings -> Search & Keys)
# and sent request-scoped via X-SerpApi-Key; never store them in .env or server config.
